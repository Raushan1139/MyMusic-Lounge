# ==========================================
# MyMusic Lounge - Environment Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Authentication Secrets
# Mandatory: Replace with a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET=mymusic_lounge_super_secret_jwt_key_change_in_production_98765
JWT_EXPIRES_IN=7d

# Database Connection URL
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mymusic_lounge?schema=public
# For zero-config local development and testing:
DATABASE_URL=file:./dev.db

# Optional Redis Connection (for caching, rate limiting, and presence tracking)
# If left blank, the application automatically uses an in-memory presence and cache manager.
REDIS_URL=

# YouTube Data API Key (Optional)
# If provided, enables enhanced metadata search and playlist imports.
# The core YouTube IFrame Player works directly with authorized YouTube video links without an API key.
YOUTUBE_API_KEY=

# Initial Administrator Credentials (used during database seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mymusiclounge.com
ADMIN_PASSWORD=AdminLounge2026!
